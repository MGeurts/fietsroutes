# Static production build for Antagonist shared hosting (Apache).
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

DirectoryIndex index.html index.php
Options -Indexes

AddType text/javascript .js .mjs
AddType application/json .json
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
AddType image/x-icon .ico
AddType application/wasm .wasm

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"

    # Content-hashed build assets may be cached permanently.
    <FilesMatch "^[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8,}\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Always revalidate entrypoints, the serviceworker and the dataset.
    <FilesMatch "^(index\.(html|php)|sw\.js|registerSW\.js|manifest\.webmanifest|network\.json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# No SPA catch-all: unknown asset paths must retain their 404 response.
# Shared route links use a URL fragment and do not need rewriting.
